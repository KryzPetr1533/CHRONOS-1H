# MLflow + Postgres + MinIO (local dev)
# ---------------------------------------------------------------------------
# Setup on a new machine:
#   cp mlflow/.env.example mlflow/.env
#   # Colima/macOS: brew install docker-compose  (if `docker compose` is missing)
#   make mlflow-up
#   make build              # dev image (btcusdt-dev:latest)
#   make upload-datasets    # runs upload inside dev container on compose network
#   make s3-ls-datasets
#
# MLflow UI:    http://localhost:5050
# MinIO console: http://localhost:9001  (login = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
# S3 API:       http://localhost:9000
#
# Keep mlflow/.env out of git (see root .gitignore). Change secrets for anything
# exposed beyond localhost.

# --- Postgres (MLflow backend store) ---
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow

# --- MinIO (S3-compatible artifact store) ---
# Must match conf/mlflow/local.yaml and chronos_ts.tracking.configure_mlflow() defaults
# when training from the host (notebooks / make train-final with localhost endpoints).
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

# Host ports mapped to MinIO (container listens on 9000 API, 9001 console)
S3_API_PORT=9000
S3_UI_PORT=9001

# Bucket created automatically by the `mc` service in docker-compose.yml
DEFAULT_BUCKET_NAME=mlflow-bucket
