# Optional: copy to repo root for notebooks / local Python
#   cp .env.example .env
#
# Docker Compose reads mlflow/.env (not this file). For MLflow stack setup use:
#   cp mlflow/.env.example mlflow/.env

# --- MLflow tracking (host → containers) ---
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Same credentials as MINIO_ROOT_* in mlflow/.env
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password

# --- Binance public API (optional overrides) ---
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_VISION_BASE=https://data.binance.vision
